# Copie para .env (cp .env.example .env) e preencha. O .env nunca vai para o git.

# Binance: API Management > Create API. Marque SOMENTE "Enable Reading" e "Enable Futures".
# NUNCA marque "Enable Withdrawals". Restrinja ao IP do seu computador/servidor.
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# Telegram: crie o bot no @BotFather (token) e pegue seu chat_id no @userinfobot.
FREQTRADE__TELEGRAM__ENABLED=true
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=

# Painel web FreqUI em http://localhost:8080 (opcional).
FREQTRADE__API_SERVER__ENABLED=true
FREQTRADE__API_SERVER__USERNAME=admin
FREQTRADE__API_SERVER__PASSWORD=troque-esta-senha
FREQTRADE__API_SERVER__JWT_SECRET_KEY=troque-por-um-texto-aleatorio-longo

# Simulação (true) ou dinheiro real (false). Só mude para false depois do dry-run.
FREQTRADE__DRY_RUN=true
