# Copy to .env — never commit real secrets

# Postgres
POSTGRES_USER=creator
POSTGRES_PASSWORD=creator
POSTGRES_DB=creator_hub
DATABASE_URL=postgres://creator:creator@postgres:5432/creator_hub

# API
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Browser origin for the web UI (Vite dev or Compose web profile on :5173)
CORS_ORIGIN=http://localhost:5173

# Baked into the web Docker image at build time (browser → host API port)
VITE_API_URL=http://localhost:3000

# Auth (change in any non-local environment)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=creator_hub_session
COOKIE_SECURE=false

# Seed user (bootstrap single-operator)
SEED_USER_EMAIL=admin@creator.local
SEED_USER_PASSWORD=changeme123
SEED_USER_DISPLAY_NAME=Gabriel

# Local media volume path (inside API container)
MEDIA_ROOT=/data/media
# Upload limits (bytes)
MEDIA_MAX_IMAGE_BYTES=15728640
MEDIA_MAX_VIDEO_BYTES=209715200

# Social credential vault (AES-256-GCM). Min 32 chars.
# MVP limitation: single env key — not KMS / HashiCorp Vault. Rotate = re-encrypt rows.
CREDENTIALS_ENCRYPTION_KEY=local-dev-only-change-me-credentials-key!!
